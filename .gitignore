# ============================================================
# Whitelist strategy: ignore EVERYTHING by default, then allow
# only the files this repository ships.
# Layout: repo root = LICENSE / README* / skills/<skill-name>/
# ============================================================

# 1) Ignore everything at the repository root
/*

# 2) Allow repository-level files, and the skills/ folder
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/README.zh-CN.md
!/CHANGELOG.md
!/skills/
!/dsh/

# 3) skills/ — descend one level at a time, allow only what we ship
/skills/*
!/skills/*/
/skills/*/*
!/skills/*/SKILL.md
!/skills/*/skill.md
!/skills/*/scripts/
/skills/*/scripts/*
!/skills/*/scripts/*.py

# 4) dsh/ — DSH (DeepSeek Harness) 适配版
/dsh/*
!/dsh/README.zh-CN.md
!/dsh/skills/
/dsh/skills/*
!/dsh/skills/*/
/dsh/skills/*/*
!/dsh/skills/*/SKILL.md
!/dsh/skills/*/scripts/
/dsh/skills/*/scripts/*
!/dsh/skills/*/scripts/*
!/dsh/dsh-go-plugin/
/dsh/dsh-go-plugin/*
!/dsh/dsh-go-plugin/*/
/dsh/dsh-go-plugin/*/*
!/dsh/dsh-go-plugin/*/*.md
!/dsh/dsh-go-plugin/*/*.json
!/dsh/dsh-go-plugin/*/*.yml
!/dsh/dsh-go-plugin/*/lib/
/dsh/dsh-go-plugin/*/lib/*
!/dsh/dsh-go-plugin/*/lib/*

# 5) Safety net: never commit these, whatever the layout becomes.
#    (The last matching pattern wins — keep this block at the end.)
__pycache__/
*.py[cod]
*.pyo
*.so
*.egg-info/
.venv/
venv/
.env
.env.*
*.key
*.pem
*.p12
*.zip
*.log
handoff/
room_db*
*.sqlite
*.db
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/